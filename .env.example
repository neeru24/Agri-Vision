# Copy this file to `.env` and fill in the values below.
# NOTE: `SECRET_KEY` is required in production and must be kept secret.
# Generate a secure key like this:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Get your free API key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweathermap-api-key

# Redis Configuration
# For local development: redis://localhost:6379/0
# For Docker: redis://redis:6379/0  
# For Redis Cloud: redis://username:password@host:port/db
REDIS_URL=redis://localhost:6379/0
